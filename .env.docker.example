# Docker 部署用的环境变量。
#
#   cp .env.docker.example .env
#
# **这个文件在仓库根目录**（不是 backend/）—— compose 的插值（${WORKSPACE_ROOT}
# 之类）只认项目目录下的 .env，容器的环境变量也从它注入。
# 本地开发用的是 `backend/.env`，两份不是一回事。
#
# .env 已被 .gitignore 忽略，不会进仓库。

# ---- 部署必需 ----

# 生产不是开发：别把异常栈直接甩给客户端
DEBUG=false

# 工作区根目录：**必须是绝对路径**，且宿主与容器里是同一个路径字符串
# （沙箱容器的挂载参数按宿主路径解释，见 docker-compose.yml 的注释）。
#
# macOS 上必须放在 $HOME 下面 —— Docker Desktop / Colima 只共享 $HOME，
# 放别处 docker 不报错，只是挂个空目录进去。
WORKSPACE_ROOT="/Users/lian/qzd-workspace"

# 仓库目录的根：agent 的「工作目录」只能落在这些目录里
# （`REPO_ROOTS` 白名单 —— 平台没有鉴权，白名单是唯一的闸门）。
#
# **同样要挂进容器**（compose 里挂的是这个路径），路径也要一致 ——
# 没挂进来的目录平台看不见，那份白名单就是空的。
REPOS_ROOT="/Users/lian/qzd-repos"
REPO_ROOTS="/Users/lian/qzd-repos"

# 控制台对外端口
FRONTEND_PORT=8080

# **API Key 加密主密钥** —— 库里存着的供应商密钥靠它加密。
# 生成一把：
#     cd backend && ../.venv/bin/python scripts/gen_encryption_key.py
# ⚠️ 换掉这把钥匙，库里已加密的 API Key 就再也解不开了，只能重新录入。
API_KEY_ENCRYPTION_KEY=""

# ---- 模型（可选，兜底用）----
#
# 正式走平台的话，模型在「模型接入配置」页面里管，这里的值只是兜底。
#
# **LLM_PROVIDER 直接写厂商名就行**（`deepseek` / `qwen` / `moonshot` /
# `openai` / `anthropic` / `ollama` …）—— 平台会自动映射成 OpenAI 兼容端点
# 并带上该厂商的默认地址与上下文窗口，**不用自己拼 base_url，也不用装
# langchain-deepseek 那类包**。
#
# 例：
#     LLM_PROVIDER="deepseek"
#     LLM_MODEL="deepseek-chat"
#     LLM_API_KEY="sk-..."
#
# 厂商预设表里没有的名字（langchain 自己的 provider 名）就原样用，
# 这时地址得自己写 LLM_BASE_URL。

LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
LLM_BASE_URL=""
# 上下文窗口（token）。0 = 未知 —— 填了才知道什么时候压缩对话历史。
# 不填就跟着 LLM_PROVIDER 的厂商预设走（DeepSeek 是 1048576）。
LLM_CONTEXT_WINDOW=0

# ---- 沙箱 ----

# agent 跑命令的沙箱容器。生产保持 docker（local 模式**没有任何隔离**）。
SANDBOX_TYPE="docker"
SANDBOX_IMAGE="python:3.13-slim"
SANDBOX_TIMEOUT=60
# 容器里的挂载点
AGENT_DOCKER_MOUNT="/workspace"

# ---- 其它（不写就用代码里的默认值）----

# 进程级总闸：允许把会话切成 bypass（跳过所有审批）。
# ⚠️ 平台没有鉴权 —— 这个开关开着，任何能调接口的人都能拿到无审批的执行权。
# 默认保持 false。
CAPABILITY_ALLOW_BYPASS=false

# CORS：同域部署用不到，留空数组最省事
CORS_ORIGINS=[]
