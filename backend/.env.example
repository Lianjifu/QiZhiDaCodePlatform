# ---- 应用 ----
APP_NAME="QiZhiDa Code Platform API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="启智达代码平台后端服务"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---- 服务 ----
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# ---- 数据库 ----
# 同步 URL 用于 Alembic，异步 URL 用于运行时
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DATABASE_SYNC_URL="sqlite:///./app.db"
DB_ECHO=false
# 开发期自动建表；正式用 Alembic 迁移时改成 false
DB_AUTO_CREATE_TABLES=true

# ---- CORS（JSON 数组）----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- 日志 ----
LOG_LEVEL="INFO"

# ---- LLM / Agent（LangChain）----
# PROVIDER: openai | anthropic | ollama
# 国产模型（DeepSeek / 通义 / Kimi）用 openai + LLM_BASE_URL 即可
# 注意：正式走平台的话，这些改用「模型接入配置」接口管理，.env 只作兜底
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
# OpenAI 兼容网关地址，例如 https://api.deepseek.com/v1
LLM_BASE_URL=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
AGENT_MAX_STEPS=20

# ---- API Key 加密 ----
# 主密钥，用 `python scripts/gen_encryption_key.py` 生成
# 更换主密钥会导致库里已加密的 API Key 无法解密
API_KEY_ENCRYPTION_KEY=""
# Azure OpenAI 专用
AZURE_OPENAI_API_VERSION="2024-10-21"

# ---- 代码沙箱 ----
# SANDBOX_TYPE: docker（默认，有隔离）| local（开发用，无隔离）
# local 模式没有任何隔离：生成的代码能读写本机任意文件、能联网。仅限本地开发。
SANDBOX_TYPE="docker"
SANDBOX_IMAGE="python:3.13-slim"
SANDBOX_TIMEOUT=60

# ---- Agent 工作区 ----
WORKSPACE_ROOT="./workspace"
AGENT_MAX_FILE_BYTES=200000
AGENT_DOCKER_MOUNT="/workspace"
AGENT_CHECKPOINTER_DB="./agent_checkpoints.db"

# ---- 联网搜索（web_search 能力用）----
# PROVIDER: tavily | serper | bing
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""

# ---- 能力治理 ----
# 信任模式：
#   strict      按能力声明逐条审批（生产）
#   balanced    读写自动放行；执行命令 / 联网抓取需要人工审批（默认）
#   permissive  只有破坏性操作需要审批（本地开发）
CAPABILITY_TRUST_MODE="balanced"
# 能力没声明超时时的兜底（秒）
CAPABILITY_DEFAULT_TIMEOUT=30
# 审批请求超时自动拒绝（秒）
CAPABILITY_APPROVAL_TIMEOUT=300
# 单会话并发执行上限
CAPABILITY_MAX_CONCURRENCY=4
# 能力没声明重试策略时的兜底
CAPABILITY_RETRY_MAX_ATTEMPTS=1
# 额外的脱敏正则（逗号分隔），追加到默认规则后面
CAPABILITY_REDACT_PATTERNS=""
# 内部域名后缀（SSRF 判定用，逗号分隔）
CAPABILITY_INTERNAL_DOMAINS="localhost,.internal,.local"

# ---- 熔断（按能力统计滑动窗口）----
# 窗口内样本达到下限且错误率超阈值，就快速失败一段时间
CAPABILITY_BREAKER_WINDOW=60
CAPABILITY_BREAKER_MIN_SAMPLES=5
CAPABILITY_BREAKER_ERROR_RATE=0.5
CAPABILITY_BREAKER_COOLDOWN=30
# 慢调用也算"劣化"的阈值（毫秒）
CAPABILITY_BREAKER_LATENCY_MS=5000

# ---- 任务置信度 ----
# 低于阈值判定任务阻塞，转人工
CAPABILITY_CONFIDENCE_BLOCK_THRESHOLD=40
# 同一能力连续多少次格式类错误就阻塞
CAPABILITY_MAX_FORMAT_RETRIES=3

# ---- RAG ----
# 分块参数（字符数，不是 token 数）
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# 单篇文档上限（字符）
RAG_MAX_DOCUMENT_CHARS=200000
# 检索默认返回条数
RAG_TOP_K=8
# 混合检索的融合权重
RAG_VECTOR_WEIGHT=1.0
RAG_KEYWORD_WEIGHT=1.0
# 向量化环境变量兜底。正式配置走「模型接入配置」接口（密钥才有加密存储）：
#   在那条配置里填 embedding_model，RAG 就会用它。
RAG_EMBEDDING_MODEL=""
RAG_EMBEDDING_BASE_URL=""
RAG_EMBEDDING_API_KEY=""
RAG_EMBEDDING_DIM=0
RAG_EMBEDDING_TIMEOUT=60
RAG_EMBEDDING_BATCH_SIZE=32

