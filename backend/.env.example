# ---- 应用 ----
APP_NAME="QiZhiDa Code Platform API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="启智达代码平台后端服务"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---- 服务 ----
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# ---- 数据库 ----
# 同步 URL 用于 Alembic，异步 URL 用于运行时
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DATABASE_SYNC_URL="sqlite:///./app.db"
DB_ECHO=false
# 开发期自动建表；正式用 Alembic 迁移时改成 false
DB_AUTO_CREATE_TABLES=true

# ---- CORS（JSON 数组）----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- 日志 ----
LOG_LEVEL="INFO"

# ---- LLM / Agent（LangChain）----
# PROVIDER: openai | anthropic | ollama
# 国产模型（DeepSeek / 通义 / Kimi）用 openai + LLM_BASE_URL 即可
# 注意：正式走平台的话，这些改用「模型接入配置」接口管理，.env 只作兜底
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
# OpenAI 兼容网关地址，例如 https://api.deepseek.com/v1
LLM_BASE_URL=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
AGENT_MAX_STEPS=20

# ---- API Key 加密 ----
# 主密钥，用 `python scripts/gen_encryption_key.py` 生成
# 更换主密钥会导致库里已加密的 API Key 无法解密
API_KEY_ENCRYPTION_KEY=""
# Azure OpenAI 专用
AZURE_OPENAI_API_VERSION="2024-10-21"

# ---- 代码沙箱 ----
# SANDBOX_TYPE: local（开发用，无隔离）| docker（生产用，有隔离）
SANDBOX_TYPE="local"
SANDBOX_IMAGE="python:3.13-slim"
SANDBOX_TIMEOUT=60

# ---- Agent 工作区 ----
WORKSPACE_ROOT="./workspace"
AGENT_MAX_FILE_BYTES=200000
AGENT_DOCKER_MOUNT="/workspace"
AGENT_CHECKPOINTER_DB="./agent_checkpoints.db"

# ---- 联网搜索（web_search 能力用）----
# PROVIDER: tavily | serper | bing
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""

