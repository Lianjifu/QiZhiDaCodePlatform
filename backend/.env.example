# ---- 应用 ----
APP_NAME="QiZhiDa Code Platform API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="启智达代码平台后端服务"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---- 服务 ----
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# ---- 数据库 ----
# 同步 URL 用于 Alembic，异步 URL 用于运行时
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DATABASE_SYNC_URL="sqlite:///./app.db"
DB_ECHO=false

# ---- CORS（JSON 数组）----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- 日志 ----
LOG_LEVEL="INFO"
