# ---- 应用 ----
APP_NAME="QiZhiDa Code Platform API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="企智搭·代码平台后端服务"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---- 服务 ----
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# ---- 数据库 ----
# 同步 URL 用于 Alembic，异步 URL 用于运行时
DATABASE_URL="sqlite+aiosqlite:///./app.db"
DATABASE_SYNC_URL="sqlite:///./app.db"
DB_ECHO=false
# 开发期自动建表；正式用 Alembic 迁移时改成 false
DB_AUTO_CREATE_TABLES=true

# ---- CORS（JSON 数组）----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- 日志 ----
LOG_LEVEL="INFO"

# ---- LLM / Agent（LangChain）----
# PROVIDER: openai | anthropic | ollama
# 国产模型（DeepSeek / 通义 / Kimi）用 openai + LLM_BASE_URL 即可
# 注意：正式走平台的话，这些改用「模型接入配置」接口管理，.env 只作兜底
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
# OpenAI 兼容网关地址，例如 https://api.deepseek.com
LLM_BASE_URL=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
# 上下文窗口（token）。0 = 未知。
#
# 这个值决定对话历史什么时候被压缩、按什么比例保留。deepAgents 的摘要阈值按
# model.profile["max_input_tokens"] 算比例，而 OpenAI 兼容端点挂上去的模型对象
# 没有 profile —— 不显式告诉它，框架只能用固定的"170000 token 触发、保留 6 条
# 消息"，对大窗口的模型来说太激进。
#
# 走「模型接入配置」时，这个值由供应商记录的 context_window 决定（默认取厂商
# 预设），这里只管 .env 兜底那条路。DeepSeek 是 1048576。
LLM_CONTEXT_WINDOW=0

# 这个模型能不能看图。
#
# 对话里上传的图片会**直接内联进消息**发给模型（image_url），模型不认这个
# 格式就会直接报错，所以这里必须声明。
#
# 走「模型接入配置」时用那条配置上的 vision_enabled（默认取厂商预设：OpenAI /
# Anthropic / DeepSeek / Gemini / Azure OpenAI 为真）。这里只管 .env 兜底那条路。
LLM_VISION_ENABLED=false
AGENT_MAX_STEPS=20

# ---- API Key 加密 ----
# 主密钥，用 `python scripts/gen_encryption_key.py` 生成
# 更换主密钥会导致库里已加密的 API Key 无法解密
API_KEY_ENCRYPTION_KEY=""
# Azure OpenAI 专用
AZURE_OPENAI_API_VERSION="2024-10-21"

# ---- 代码沙箱 ----
# SANDBOX_TYPE: docker（默认，有隔离）| local（开发用，无隔离）
# local 模式没有任何隔离：生成的代码能读写本机任意文件、能联网。仅限本地开发。
SANDBOX_TYPE="docker"
SANDBOX_IMAGE="python:3.13-slim"
SANDBOX_TIMEOUT=60
# 沙箱容器空闲多久回收（秒）。容器按会话复用，空闲太久就删掉。
# 平台里没有"会话结束"这个事件，所以只能靠空闲超时回收。
SANDBOX_IDLE_TIMEOUT=1800
# 同时存活的沙箱容器上限。超了会把最久没用的那个回收掉。
SANDBOX_MAX_CONTAINERS=32

# ---- Agent 工作区 ----
WORKSPACE_ROOT="./workspace"
AGENT_MAX_FILE_BYTES=200000
AGENT_DOCKER_MOUNT="/workspace"
AGENT_CHECKPOINTER_DB="./agent_checkpoints.db"

# ---- 文件（上传 / 下载）----
# 单个上传文件的上限（字节）
MAX_UPLOAD_BYTES=52428800
# 单个文件下载的上限（字节）
MAX_DOWNLOAD_BYTES=52428800
# 能内联进对话、让模型直接"看见"的图片大小上限（字节）。
# 超过就只给路径 —— base64 内联会让 checkpoint 明显膨胀。
MAX_INLINE_IMAGE_BYTES=5242880
# 一轮对话最多带几个附件
MAX_ATTACHMENTS_PER_TURN=10
# 上下文里「上传件」块最多列几个文件
UPLOADS_BLOCK_MAX_ENTRIES=20

# ---- 联网搜索（web_search 能力用）----
# PROVIDER: tavily | serper | bing
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""

# ---- 能力治理 ----
# 信任模式：
#   strict      按能力声明逐条审批（生产）
#   balanced    读写自动放行；执行命令 / 联网抓取需要人工审批（默认）
#   permissive  只有破坏性操作需要审批（本地开发）
CAPABILITY_TRUST_MODE="balanced"
# 能力没声明超时时的兜底（秒）
CAPABILITY_DEFAULT_TIMEOUT=30
# 审批请求超时自动拒绝（秒）
CAPABILITY_APPROVAL_TIMEOUT=300
# 单会话并发执行上限
CAPABILITY_MAX_CONCURRENCY=4
# 能力没声明重试策略时的兜底
CAPABILITY_RETRY_MAX_ATTEMPTS=1
# 额外的脱敏正则（逗号分隔），追加到默认规则后面
CAPABILITY_REDACT_PATTERNS=""
# 内部域名后缀（SSRF 判定用，逗号分隔）
CAPABILITY_INTERNAL_DOMAINS="localhost,.internal,.local"

# ---- 熔断（按能力统计滑动窗口）----
# 窗口内样本达到下限且错误率超阈值，就快速失败一段时间
CAPABILITY_BREAKER_WINDOW=60
CAPABILITY_BREAKER_MIN_SAMPLES=5
CAPABILITY_BREAKER_ERROR_RATE=0.5
CAPABILITY_BREAKER_COOLDOWN=30
# 慢调用也算"劣化"的阈值（毫秒）
CAPABILITY_BREAKER_LATENCY_MS=5000

# ---- 任务置信度 ----
# 低于阈值判定任务阻塞，转人工
CAPABILITY_CONFIDENCE_BLOCK_THRESHOLD=40
# 同一能力连续多少次格式类错误就阻塞
CAPABILITY_MAX_FORMAT_RETRIES=3

# ---- RAG ----
# 分块参数（字符数，不是 token 数）
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# 单篇文档上限（字符）
RAG_MAX_DOCUMENT_CHARS=200000
# 检索默认返回条数
RAG_TOP_K=8
# 混合检索的融合权重
RAG_VECTOR_WEIGHT=1.0
RAG_KEYWORD_WEIGHT=1.0
# 向量化环境变量兜底。正式配置走「模型接入配置」接口（密钥才有加密存储）：
#   在那条配置里填 embedding_model，RAG 就会用它。
RAG_EMBEDDING_MODEL=""
RAG_EMBEDDING_BASE_URL=""
RAG_EMBEDDING_API_KEY=""
RAG_EMBEDDING_DIM=0
RAG_EMBEDDING_TIMEOUT=60
RAG_EMBEDDING_BATCH_SIZE=32


# ---- 上下文模块 ----
# 上下文占模型窗口的比例。另一半留给模型输出、工具 schema 和 deepAgents
# 自己追加的提示词 —— 那部分我们控制不了，只能留地方。
CONTEXT_BUDGET_RATIO=0.5
# 一个 token 折算多少字符（英文约 4，中文约 1.5）
CONTEXT_CHARS_PER_TOKEN=4.0
# 技能清单里最多列几个技能（0 = 不限制）。正文本来就按需读，这里限的是
# 每轮都进提示词的那份 name + description 清单。
CONTEXT_MAX_SKILLS_IN_PROMPT=20

# ---- 记忆模块 ----
# 长期记忆用的 RAG 集合名；留空 = 只支持会话内记忆
#
# 平台**不会自动建这个集合**：RAG 集合的向量化配置（模型 + 维度）是建集合时
# 锁死的，建错了只能重建。要用长期记忆，先在 RAG 界面建好集合、选好 embedding
# 模型，再把集合名填到这里。没配时 memory_search / memory_write 会明确报错。
MEMORY_COLLECTION_NAME=""
# 是否每轮自动把记忆目录注入上下文
MEMORY_CATALOG_ENABLED=true
# 目录块的字符预算（每轮都付这笔钱，所以要小）
MEMORY_CATALOG_BUDGET_CHARS=1200
# 目录最多几条
MEMORY_CATALOG_MAX_ENTRIES=40
# 单条摘要的长度上限
MEMORY_SUMMARY_MAX_CHARS=200
# 时间衰减半衰期（天）。只影响排序微调，不影响召回资格
MEMORY_DECAY_HALF_LIFE_DAYS=30
